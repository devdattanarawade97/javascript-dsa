NODE_ENV=production
PORT=5000 # Often 80 or 443 in production, but backend listens on internal port
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority # Replace with your actual production MongoDB URI
JWT_SECRET=YOUR_VERY_STRONG_AND_RANDOM_SECRET_KEY_FOR_PRODUCTION_DO_NOT_SHARE
JWT_EXPIRE=24h # Tokens should expire for security reasons